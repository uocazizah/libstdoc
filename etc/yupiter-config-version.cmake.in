# yupiter - CMake package version file
#
# Generated from etc/yupiter-config-version.cmake.in by the build.
# A package is compatible when it has the requested major version and
# is not older than the requested version: the interface is stable
# within a major release.

set(PACKAGE_VERSION "@VERSION@")

set(PACKAGE_VERSION_COMPATIBLE FALSE)
set(PACKAGE_VERSION_EXACT FALSE)

if(PACKAGE_FIND_VERSION_MAJOR AND
   (PACKAGE_FIND_VERSION_MAJOR EQUAL @VERSION_MAJOR@))
    if(NOT PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
    endif()

    if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
endif()
